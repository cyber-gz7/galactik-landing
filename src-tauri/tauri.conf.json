{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Galactik Live",
  "version": "2.1.2",
  "identifier": "com.gz7.galacticlive",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Galactik Live — Pro Broadcast Suite",
        "width": 1340,
        "height": 840,
        "minWidth": 1020,
        "minHeight": 660,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": ["nsis"],
    "publisher": "CyberGZ7 · CJ7TEC",
    "copyright": "Copyright © 2026 CyberGZ7. Todos los derechos reservados.",
    "category": "Utility",
    "license": "LICENSE",
    "shortDescription": "Suite de overlays interactivos para TikTok Live",
    "longDescription": "Galactik Live es la suite profesional de overlays, TTS y gestión de regalos para streamers de TikTok Live.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "icons/nsis-header.bmp",
        "sidebarImage": "icons/nsis-sidebar.bmp",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      }
    },
    "resources": {
      "../tiktok-sidecar.mjs": "tiktok-runtime/tiktok-sidecar.mjs",
      "../package.json": "tiktok-runtime/package.json",
      "../node_modules": "tiktok-runtime/node_modules",
      "../runtime/node.exe": "tiktok-runtime/node.exe"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0MUI3QzQ4MEYwQ0Y2MkMKUldUS3d3dWt5c2k2SEZkaW9BTTZHTWR3NnkrNG5YdzV5WnZ0bjl6bm1QZmlkZXhlNzl4Y0F2L1AK",
      "endpoints": [
        "https://bygerardguzman.github.io/galactik-releases/latest.json",
        "https://github.com/bygerardguzman/galactik-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
